node_modules
dist
dist-ssr
*.local
src-tauri/target
src-tauri/gen/schemas
.DS_Store
.vscode/*
!.vscode/extensions.json

# OpenWolf - per-session state and generated scaffolding stay untracked; the four
# durable knowledge files are tracked. `openwolf update` preserves those as user
# data (USER_DATA_FILES in the CLI's update.js); everything else under .wolf/ is
# regenerated by `openwolf init --agent claude` in a fresh clone, so tracking it
# only churns on every upgrade and invites local edits the next update strips.
# Allowlist, not a blocklist, so a new OpenWolf artefact is ignored by default.
# Same rule in every repo under ~/Projects.
/.wolf/*
!/.wolf/cerebrum.md
!/.wolf/STATUS.md
!/.wolf/config.json
!/.wolf/buglog.json

# Claude Code / Codex scaffolding - regenerated by `openwolf init --agent claude`
/.claude
/.codex
/CLAUDE.md
/AGENTS.md

# Release artefacts (attached to GitHub releases, not tracked)
dist-release
