node_modules
dist
dist-ssr
*.local
src-tauri/target
src-tauri/gen/schemas
.DS_Store
.vscode/*
!.vscode/extensions.json

# Claude Code / Codex scaffolding. This repo is public, so anything about this
# machine or its owner stays out: per-machine slash commands, skills and local
# settings. The four files sift generates are not that — CLAUDE.md, AGENTS.md
# and the two hook registrations hold its stanza and wiring, the same text
# that is public in the sift repo itself — so a clone gets them.
/.claude/*
!/.claude/settings.json
/.codex/*
!/.codex/hooks.json

# Release artefacts (attached to GitHub releases, not tracked)
dist-release

# sift: derived state and private notes
_sift/.cache/
_sift/local/
