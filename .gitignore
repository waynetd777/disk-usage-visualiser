node_modules
dist
dist-ssr
*.local
src-tauri/target
src-tauri/gen/schemas
.DS_Store
.vscode/*
!.vscode/extensions.json

# OpenWolf - nothing under .wolf/ is tracked. This repo is public, and the
# knowledge files (cerebrum.md, STATUS.md) are working notes about this machine
# and its owner, not project documentation. The usual ~/Projects allowlist that
# tracks the four durable files does NOT apply here for that reason.
/.wolf/

# Claude Code / Codex scaffolding - regenerated by `openwolf init --agent claude`
/.claude
/.codex
/CLAUDE.md
/AGENTS.md

# Release artefacts (attached to GitHub releases, not tracked)
dist-release
