{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disk Usage",
  "version": "0.1.0",
  "identifier": "com.wayned.disk-usage-visualiser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Disk Usage",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Backup Manager Dev"
    }
  }
}
